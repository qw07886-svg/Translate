{
  "name": "@local/dsh-drawing-translator",
  "version": "0.2.0",
  "private": true,
  "description": "Translate PDF / DWG drawings and Word documents into Chinese from a left-sidebar panel.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "python/*.py",
    "bin/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
